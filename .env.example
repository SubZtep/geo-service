# API Configuration
PORT=3000
API_KEY=your-secret-api-key-here

# Queue Configuration
QUEUE_CONCURRENCY=2

# Public MCP route (/mcp/public) rate limit, per client IP
PUBLIC_MCP_RATE_LIMIT=600
PUBLIC_MCP_RATE_WINDOW_MS=60000

# GeoIP Database
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# MaxMind credentials (for downloading the database)
GEOIP_ACCOUNT_ID=your-account-id
GEOIP_LICENSE_KEY=your-license-key
